# Public project configuration. These values are safe to commit.
NEXT_PUBLIC_SANITY_PROJECT_ID=gknd24m7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-11

# Private Viewer token. Keep this local or in GitHub Actions secrets.
SANITY_API_READ_TOKEN=

# Cloudflare runtime: keep these private in .dev.vars / Worker secrets.
SANITY_PUBLISH_SECRET=
# GitHub CI uses a separate Worker-only account token, never a Worker binding.
# Repository secret names: CLOUDFLARE_TROY_DEPLOY_TOKEN,
# CLOUDFLARE_SANITY_READ_TOKEN, SANITY_PUBLISH_SECRET.
